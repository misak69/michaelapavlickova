* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

section {
    background-color: white;
    width: 100vw;
    height: 100vh;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(5, 1fr);
    gap: 10px;
        }

.zelena {
    background: rgb(7, 100, 7);
    grid-area: 2 / 2 / 3 / 3;
    padding: 7%;
    color: rgb(175, 238, 191);
}

.tmave zelena {
    background: rgb(30, 71, 5);
    grid-area: 2 / 3 / 3 / 3;
    padding: 7%;
    color: rgb(19, 66, 8);
}

.hneda {
    background: rgb(85, 61, 15);
    grid-area: 2 / 4 / 3 / 5;
    padding: 7%;
    color: rgb(122, 73, 17);
}

.zelena2 {
    background: rgb(6, 102, 43);
    grid-area: 3 / 2 / 4 / 3;
    padding: 10px;
    color: rgb(0, 0, 0);
}

.tmave zelena2 {
    background: rgb(31, 70, 27);
    grid-area: 3 / 3 / 4 / 3;
    padding: 10px;
    color: rgb(0, 0, 0);
}

.oranzova2 {
    background: rgb(78, 54, 8);
    grid-area: 3 / 4 / 4 / 5;
    padding: 10px;
    color: rgb(0, 0, 0);
}

.zelena3 {
    background: rgb(13, 102, 20);
    grid-area: 4 / 3 / 5 / 3;
    color: rgb(0, 0, 0);
}

.zelena3 img {
    width: 100%;
    height: 100%;
    object-fit: contain; 
}

.tmave zelena:hover {
    filter: contrast(60%);
}

.zelena:hover {
    filter: contrast(60%);
}

.hneda:hover {
    filter: contrast(60%);
}
